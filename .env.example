# Copie para .env e preencha:  cp .env.example .env
# O .env está no .gitignore. Nunca faça commit de chaves.

# Provedor do LLM: openai | anthropic
LLM_PROVIDER=openai

# Preencha a chave do provedor escolhido
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Opcional: modelo (padrão: gpt-4.1-mini para OpenAI, claude-sonnet-4-6 para Anthropic)
LLM_MODEL=

# Opcional: versão do kagent e nome do cluster
KAGENT_VERSION=0.10.6
CLUSTER_NAME=kagent-lab
